# Export these in a private shell or secret manager. This file is not loaded automatically.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
# Map actual Discord snowflakes to existing YAML participant IDs.
DISCORD_PARTICIPANTS={"123456789012345678":"david","234567890123456789":"rufus"}
REASON_COMMONS_STATE=/absolute/path/to/reasoncommons-product/collab/reason-commons.yaml
REASON_COMMONS_RUNTIME=/absolute/path/to/persistent/discord-runtime
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Required for live operation. SDK estimate, not a hard billing ceiling.
AGENT_MAX_BUDGET_USD=
AGENT_TIMEOUT_SECONDS=120
# Optional. Must be one of DISCORD_CHANNEL_IDS; proactive delivery also needs run --feedback-reminders.
DISCORD_FEEDBACK_CHANNEL_ID=
FEEDBACK_POLL_SECONDS=300
# Per-participant quiet period for additional initial requests; explicit dated deferrals use their own date.
FEEDBACK_PROMPT_COOLDOWN_SECONDS=86400
