# Local-only Claude Code / agent wiring (skill symlinks, worktrees, local settings).
# Skills themselves are tracked under top-level skills/; .claude/skills/ just
# symlinks them in so Claude Code can discover them. See AGENTS.md > Conventions.
# The shared .claude/settings.json is tracked: it points the Reason Commons
# skill at this repo's commons/ folder.
.claude/*
!.claude/settings.json
.worktrees/

# Local dashboard build tooling (the compiled dashboard under dist/ is tracked).
node_modules/
*.tsbuildinfo
__pycache__/
*.py[cod]
skills/project-ltp/dashboard/vite.config.js
skills/project-ltp/dashboard/vite.config.d.ts

# Test builds of the contribution-proposals review page. `--test` writes here so
# a half-read batch can be looked at without touching the live route or the
# repo's history. See skills/contribution-proposals/SKILL.md.
talk/2r-research-group/demo-c-test/

# macOS metadata.
.DS_Store

drafts

# Emacs scratch: autosaves (#file#), lock symlinks (.#file) and backups (file~).
# The lock files are symlinks to user@host.pid, so committing one leaves a
# dangling symlink in everyone else's checkout.
\#*\#
.\#*
*~

# Vim swap files
*.swp
*.swo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads.gate.lock

# Local accepted-history snapshots and diagrams for conversational facilitation.
/ltp/rufus-david-collab/.reason-commons/

# Private personal reasoning state and generated views.
/personal-goals.yaml
/personal-goals/
/.personal-goals/

# Reason Commons goals (commons/<goal>/) are tracked. The writer lock exists only
# while a goal is open, and cursor.yaml is each person's own draft and view.
commons/*/writer.lock
commons/*/cursor.yaml
