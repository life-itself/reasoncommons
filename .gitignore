# Local-only Claude Code / agent wiring (skill symlinks, worktrees, settings).
# Skills themselves are tracked under top-level skills/; .claude/skills/ just
# symlinks them in so Claude Code can discover them. See AGENTS.md > Conventions.
.claude/
.worktrees/

# Local build tooling.
node_modules/
*.tsbuildinfo
__pycache__/
*.py[cod]

# macOS filesystem metadata.
.DS_Store

drafts

# Emacs scratch: autosaves (#file#), lock symlinks (.#file) and backups (file~).
# The lock files are symlinks to user@host.pid, so committing one leaves a
# dangling symlink in everyone else's checkout.
\#*\#
.\#*
*~

# Vim swap files
*.swp
*.swo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads.gate.lock

# Local accepted-history snapshots and diagrams for conversational facilitation.
/ltp/rufus-david-collab/.reason-commons/

# Private personal reasoning state and generated views.
/personal-goals.yaml
/personal-goals/
/.personal-goals/
